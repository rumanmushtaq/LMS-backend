# ─── Source: old MySQL (read-only) ───────────────────────────────────────────
# Reached through an SSH tunnel; 3306 is not open to the internet.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=varona
MYSQL_USER=varona
MYSQL_PASSWORD=

# ─── SSH tunnel to the CloudPanel server ─────────────────────────────────────
SSH_HOST=72.62.162.217
SSH_PORT=22
SSH_USER=
# Use ONE of these:
SSH_PRIVATE_KEY_PATH=/home/you/.ssh/id_rsa
# SSH_PASSWORD=
# Local port the tunnel binds (forwards to MYSQL_HOST:MYSQL_PORT on the server):
SSH_LOCAL_PORT=3307

# ─── Target: new MongoDB (staging first!) ────────────────────────────────────
# Point at a STAGING/local Mongo for the first real run. Promote to prod only
# after verify passes.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=varona_academy_staging
