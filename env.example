# Application
NODE_ENV=development
PORT=3000
APP_NAME=Varona Academy
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Database
MONGODB_URI=mongodb://localhost:27017/varona-academy

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Sliding session policy
# Idle window: no meaningful activity for this long ends the session, and no
# refresh token can revive it. Keep in step with JWT_ACCESS_EXPIRATION.
SESSION_IDLE_TIMEOUT_MS=900000
# Hard ceiling regardless of activity, so continuous use cannot keep one login
# alive forever. 604800000 = 7 days.
SESSION_ABSOLUTE_LIFETIME_MS=604800000
# How often lastActivityAt is actually written. Lower costs more database
# writes; higher can expire a session up to this much early.
SESSION_ACTIVITY_WRITE_INTERVAL_MS=60000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@varona-academy.com
SMTP_FROM_NAME=Varona Academy

# Token Expiration
EMAIL_VERIFICATION_EXPIRATION=24h
PASSWORD_RESET_EXPIRATION=1h

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 2FA Configuration
TWO_FA_APP_NAME=VaronaAcademy

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Vimeo Live (video conferencing / broadcast for live classes)
# Create an app at https://developer.vimeo.com/apps and generate a personal
# access token with the `create`, `edit` and `video_files` scopes, on a paid
# plan that has live streaming enabled. Live-class endpoints return a clear
# 503 if this is missing, so the rest of the app still runs without it.
VIMEO_ACCESS_TOKEN=your-vimeo-access-token
VIMEO_API_VERSION=3.4


# IP Security (all optional — safe defaults below)
# Ships in SHADOW MODE: blocks are computed and counted on the Security
# dashboard, but no request is refused until SECURITY_ENFORCE=true.
# Flip it only after a week or two of reviewing shadow counters.
SECURITY_ENFORCE=false
# Enable ONLY when Cloudflare fronts the API and the origin firewall admits
# Cloudflare's IP ranges exclusively; otherwise the header is spoofable.
SECURITY_TRUST_CLOUDFLARE=false
# Auto-block when this many DISTINCT accounts fail login from one IP
# (IPv6: one /64) within the window. Deliberately high: carrier-grade NAT
# can put a whole city behind one IPv4.
SECURITY_FAILED_LOGIN_THRESHOLD=30
SECURITY_FAILED_LOGIN_WINDOW_MIN=10
# First auto-block lasts this long; repeat offenses escalate 1x -> 4x -> 24x.
SECURITY_AUTOBLOCK_BASE_MINUTES=15
# IP activity buckets self-delete after this many days (IPs are personal data).
SECURITY_ACTIVITY_RETENTION_DAYS=90

# ── Payments ──────────────────────────────────────────────────────────────
# Stripe (cards). STRIPE_WEBHOOK_SECRET is required to accept webhooks —
# without it the endpoint refuses every request rather than trusting an
# unverified one, since only a webhook may mark a payment paid.
STRIPE_WEBHOOK_SECRET=

# PSE (Colombian bank transfer).
# Stripe CANNOT process PSE. Set these once a Colombian PSP is chosen
# (wompi | mercadopago | epayco | payu | dlocal). PSE is hidden from the
# payment picker until all of PROVIDER, API_KEY and WEBHOOK_SECRET are set.
PSE_PROVIDER=
PSE_API_KEY=
PSE_API_SECRET=
PSE_WEBHOOK_SECRET=
PSE_BASE_URL=
